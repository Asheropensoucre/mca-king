# Supabase
SUPABASE_URL=your-supabase-project-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Better Auth / App URL
DATABASE_URL=your-supabase-postgres-or-pooler-url
BETTER_AUTH_SECRET=random-32-character-string
BETTER_AUTH_URL=https://your-vercel-app-url.vercel.app

# Security / CSRF / Rate Limiting
# Comma-separated list of allowed browser origins for authenticated mutating API requests.
# Include your production app origin, e.g. https://portal.mcaking.com
APP_ALLOWED_ORIGINS=https://your-vercel-app-url.vercel.app
# Rate limit storage. Use the default Supabase-backed durable tables in production.
# Set to memory only for local development/testing if Supabase is unavailable.
RATE_LIMIT_STORE=supabase

# Resend
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=noreply@yourdomain.com
# Optional but recommended: Resend webhook signing secret. If set, /api/webhooks/resend rejects invalid signatures.
RESEND_WEBHOOK_SECRET=your-resend-webhook-signing-secret

# Gemini AI (server-only secret; do not prefix with VITE_)
GEMINI_API_KEY=your-gemini-api-key

# Vite public vars (safe to expose to browser)
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Campaign email compliance
# Required before sending marketing/campaign emails. Appears in unsubscribe/footer copy.
BROKER_PHYSICAL_ADDRESS=MCA King, [Your Street], [City], [State] [ZIP]
